{
  "hosting": {
    "site": "fabric8-50559",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/.firebase/**",
      ".idea/**",
      "**/.idea/**",
      "**/node_modules/**",
      "functions/**",
      "updates/**",
      "api/**",
      "__pycache__/**",
      "*.py",
      "*.bat",
      "*.log",
      "README.md",
      "**/*.docx",
      "Fabric8_sector_logos/**",
      "**/Fabric8_sector_logos/**",
      "assets/needs/**",
      "**/needs/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}

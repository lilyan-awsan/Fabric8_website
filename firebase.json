{
  "hosting": {
    "site": "fabric8-50559",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/.firebase/**",
      ".idea/**",
      "**/.idea/**",
      ".vscode/**",
      "**/.vscode/**",
      ".agents/**",
      "**/.agents/**",
      ".gitignore",
      "**/.env*",
      "!**/.well-known/**",
      "**/node_modules/**",
      "functions/**",
      "updates/**",
      "api/**",
      "__pycache__/**",
      "*.py",
      "*.bat",
      "*.log",
      "README.md",
      "**/*.docx",
      "Fabric8_sector_logos/**",
      "**/Fabric8_sector_logos/**",
      "assets/needs/**",
      "**/needs/**"
    ],
    "headers": [
      {
        "source": "/.well-known/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}

    "cmsSectorsHeroBg": "<div>\n        <p>Sectors Served</p>\n        <h1 id=\"cmsSectorsTitle\">Uniform concepts for every business environment</h1><span id=\"cmsSectorsSub\">Explore Our Sector Capabilities</span>\n      </div>",
    "cmsSectorsTitle": "Uniform concepts for every business environment",
    "cmsSectorsSub": "Explore Our Sector Capabilities",
    "cmsSectorFoodImg": "assets/sector-logos/food-beverage.webp",
    "cmsSectorFoodTitle": "Food & Beverage",
    "cmsSectorFoodDesc": "Restaurants, cafés, catering, quick service, and culinary teams",
    "cmsSectorFoodBackTitle": "Food & Beverage",
    "cmsSectorFoodBackDesc": "We outfit restaurants, cafés, and catering teams with uniforms built to handle the heat of a working kitchen and the pace of a busy floor. From chef coats and aprons to front-of-house polos, every piece can be custom embroidered or printed with your logo, giving your brand a consistent, professional presence from the kitchen to the table.",
    "cmsSectorHospImg": "assets/sector-logos/hospitality.webp",
    "cmsSectorHospTitle": "Hospitality",
    "cmsSectorHospDesc": "Hotels, resorts, dining outlets, front-of-house, and guest-facing teams.",
    "cmsSectorHospBackTitle": "Hospitality",
    "cmsSectorHospBackDesc": "Hotels, resorts, and dining & culinary outlets trust us to deliver uniforms that reflect their brand’s level of service. We supply everything from housekeeping and guest services attire to elegant dining staff wear, all customizable with embroidered logos and monograms that elevate guest experience and staff pride.",
    "cmsSectorCorpImg": "assets/sector-logos/corporate.webp",
    "cmsSectorCorpTitle": "Corporate",
    "cmsSectorCorpDesc": "Office, retail, sales, and customer-facing corporate teams.",
    "cmsSectorCorpBackTitle": "Corporate",
    "cmsSectorCorpBackDesc": "For office, retail, and customer-facing teams, we provide polished, professional apparel that reinforces brand identity at every touchpoint. Polos, button-downs, jackets, and more — printed or embroidered with your company logo — help your team look sharp and unified, whether they’re behind a desk or in front of customers.",
    "cmsSectorIndImg": "assets/sector-logos/industrial.webp",
    "cmsSectorIndTitle": "Industrial",
    "cmsSectorIndDesc": "Manufacturing, construction, logistics, warehouse, and field workforces.",
    "cmsSectorIndBackTitle": "Industrial",
    "cmsSectorIndBackDesc": "Manufacturing, construction, and logistics workforces need uniforms that are as tough as the job itself. We provide durable, safety-conscious workwear — from cargos to high-visibility gear — with custom embroidery and printing that keeps your crew identifiable and your brand visible on every job site.",
    "cmsSectorHealthImg": "assets/sector-logos/healthcare.webp",
    "cmsSectorHealthTitle": "Healthcare",
    "cmsSectorHealthDesc": "Hospitals, clinics, laboratories, and medical practice staff.",
    "cmsSectorHealthBackTitle": "Healthcare",
    "cmsSectorHealthBackDesc": "Hospitals, clinics, and medical facilities rely on us for scrubs, lab coats, and medical uniforms that combine comfort, durability, and a clean, professional appearance. Custom embroidery makes it easy to distinguish departments, roles, and staff — supporting both function and brand consistency in patient-facing environments.",
    "cmsSectorAviaImg": "assets/sector-logos/aviation.webp",
    "cmsSectorAviaTitle": "Aviation",
    "cmsSectorAviaDesc": "Airlines, ground handling, flight crew, and travel operational services.",
    "cmsSectorAviaBackTitle": "Aviation",
    "cmsSectorAviaBackDesc": "Airlines and ground-handling services need uniforms that project precision, safety, and professionalism. We supply flight crew and ground staff apparel with crisp tailoring and embroidered detailing, helping your team represent your airline’s standards at every gate and on every flight.",
    "cmsSectorEduImg": "assets/sector-logos/education.webp",
    "cmsSectorEduTitle": "Education",
    "cmsSectorEduDesc": "Schools, academic institutions, campus programs, and event staff.",
    "cmsSectorEduBackTitle": "Education",
    "cmsSectorEduBackDesc": "Schools and academic institutions come to us for uniforms and staff apparel that build a sense of identity and pride. From student uniforms to staff polos and spirit wear, we offer custom embroidery and printing, so every piece reflects your school’s colors, crest, and community spirit."
